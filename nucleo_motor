import json
import logging
import os
import time
import requests
import websocket

# Configuración del sistema de infraestructura y antifallo
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - [%(levelname)s] - %(message)s",
)
logger = logging.getLogger("MotorInfraestructuraBase")


class MotorInfraestructura:

  def __init__(self):
    self.nombre = "Núcleo Independiente de Infraestructura y Antifallo"

    # Credenciales de infraestructura (Telegram y Conexión base de Deriv)
    self.telegram_token = os.getenv(
        "TELEGRAM_TOKEN", "TU_TOKEN_DE_TELEGRAM_AQUI"
    )
    self.chat_id = os.getenv("TELEGRAM_CHAT_ID", "TU_CHAT_ID_AQUI")
    self.deriv_app_id = "1089"  # Identificador público de conexión general a Deriv
    self.deriv_ws_url = (
        f"wss://ws.derivws.com/websockets/v3?app_id={self.deriv_app_id}"
    )

    # Control de mensajes de Telegram (Añadido para que responda)
    self.ultimo_offset_telegram = 0

    # Memoria de persistencia para evitar pérdidas de estado ante reinicios o cortes
    self.archivo_memoria = "memoria_estado.json"
    self.estado_sistema = self.cargar_memoria()
    logger.info(f"Iniciando {self.nombre}...")

  def cargar_memoria(self):
    """Recupera automáticamente el último estado guardado en disco"""
    if os.path.exists(self.archivo_memoria):
      try:
        with open(self.archivo_memoria, "r", encoding="utf-8") as f:
          datos = json.load(f)
          logger.info(
              "Memoria recuperada con éxito. Retomando operaciones desde el"
              " último punto registrado."
          )
          return datos
      except Exception as e:
        logger.error(f"Error al leer la memoria de persistencia: {e}")
    return {
        "estado": "inicializado",
        "ciclos_completados": 0,
        "ultimo_latido": time.time(),
    }

  def guardar_memoria(self):
    """Guarda en disco el estado actual del motor ante cualquier eventualidad"""
    try:
      with open(self.archivo_memoria, "w", encoding="utf-8") as f:
        json.dump(self.estado_sistema, f, indent=4, ensure_ascii=False)
    except Exception as e:
      logger.error(f"Error al guardar la memoria del motor: {e}")

  def enviar_alerta_telegram(self, mensaje):
    """Canal de comunicación de emergencias con Telegram"""
    if self.telegram_token == "TU_TOKEN_DE_TELEGRAM_AQUI":
      logger.warning(
          f"Telegram no configurado (Modo Silencioso) -> {mensaje}"
      )
      return

    url = f"https://api.telegram.org/bot{self.telegram_token}/sendMessage"
    payload = {"chat_id": self.chat_id, "text": mensaje, "parse_mode": "Markdown"}
    try:
      respuesta = requests.post(url, json=payload, timeout=5)
      if respuesta.status_code != 200:
        logger.error(f"Error al notificar a Telegram: {respuesta.text}")
    except Exception as e:
      logger.error(f"Alerta antifallo! Falló la conexión con la API de Telegram: {e}")

  def verificar_conexion_deriv(self):
    """Verifica la pasarela de red con Deriv mediante WebSocket sin afectar el núcleo"""
    intentos = 3
    for intento in range(1, intentos + 1):
      try:
        ws = websocket.create_connection(self.deriv_ws_url, timeout=5)
        ws.close()
        return True
      except Exception as e:
        logger.warning(
            f"Reintento de conexión con Deriv ({intento}/{intentos}): {e}"
        )
        time.sleep(2)

    logger.warning(
        "Conexión con Deriv en pausa temporal (Mantenimiento o red externa)."
        " El motor sigue vivo."
    )
    return False

  def verificar_mensajes_telegram(self):
    """Escucha activa: Lee los comandos que escribes en el chat de Telegram"""
    if self.telegram_token == "TU_TOKEN_DE_TELEGRAM_AQUI":
      return

    url = f"https://api.telegram.org/bot{self.telegram_token}/getUpdates?offset={self.ultimo_offset_telegram + 1}&timeout=1"
    try:
      respuesta = requests.get(url, timeout=3)
      if respuesta.status_code == 200:
        datos = respuesta.json()
        for resultado in datos.get("result", []):
          self.ultimo_offset_telegram = resultado["update_id"]
          mensaje_obj = resultado.get("message", {})
          texto_chat = mensaje_obj.get("text", "").strip().lower()
          remitente_id = str(mensaje_obj.get("chat", {}).get("id", ""))

          # Valida que el mensaje provenga de tu chat autorizado
          if remitente_id == str(self.chat_id):
            logger.info(f"Comando recibido de Telegram: {texto_chat}")

            if "escanear" in texto_chat or "escaneo" in texto_chat:
              self.enviar_alerta_telegram(
                  "🔍 *[RESPUESTA]* Escaneo manual recibido y ejecutándose"
                  " correctamente."
              )
            elif "estado" in texto_chat:
              ciclos = self.estado_sistema.get("ciclos_completados", 0)
              self.enviar_alerta_telegram(
                  f"📊 *[ESTADO DEL MOTOR]*\n• Ciclos activos: {ciclos}\n•"
                  " Sistema operativo y funcionando."
              )
    except Exception as e:
      logger.error(f"Error al verificar mensajes de Telegram: {e}")

  def iniciar_motor_continuo(self):
    """Bucle principal añadido para mantener el motor vivo y escuchando"""
    logger.info("Iniciando bucle continuo del motor...")
    self.enviar_alerta_telegram(
        "🚀 *[MOTOR INICIADO]* Núcleo de infraestructura en línea."
    )

    while True:
      try:
        # 1. Actualizar latido y memoria
        self.estado_sistema["ciclos_completados"] = (
            self.estado_sistema.get("ciclos_completados", 0) + 1
        )
        self.estado_sistema["ultimo_latido"] = time.time()
        self.guardar_memoria()

        # 2. Verificar red de Deriv
        self.verificar_conexion_deriv()

        # 3. Escuchar comandos entrantes de Telegram (lo que faltaba)
        self.verificar_mensajes_telegram()

      except Exception as e:
        logger.error(f"Error crítico en el bucle principal: {e}")

      time.sleep(10)


if __name__ == "__main__":
  motor = MotorInfraestructura()
  try:
    motor.iniciar_motor_continuo()
  except Exception as e:
    logger.critical(f"El motor colapsó por completo: {e}")
