
import time
import logging
import requests
import json
import os
import websocket

# Configuración del núcleo de infraestructura 24/7 (Sintéticos 500/1000 y GBP/USD)
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - [%(levelname)s] - %(message)s",
)
logger = logging.getLogger("MotorInfraestructuraBlindado")

class MotorInfraestructura:
    def __init__(self):
        self.nombre = "Núcleo 24/7 Blindado con Auto-Reconexión y Memoria Persistente"

        # Credenciales de Telegram
        self.telegram_token = os.getenv("TELEGRAM_TOKEN", "TU_TOKEN_DE_TELEGRAM_AQUI")
        self.chat_id = os.getenv("TELEGRAM_CHAT_ID", "TU_CHAT_ID_AQUI")

        self.deriv_app_id = "1089"
        self.deriv_ws_url = f"wss://ws.derivws.com/websockets/v3?app_id={self.deriv_app_id}"

        self.ultimo_offset_telegram = 0

        # Archivo de persistencia para guardar el estado exacto ante cualquier caída
        self.archivo_memoria = "memoria_estado.json"
        self.estado_sistema = self.cargar_memoria()

        logger.info(f"Iniciando {self.nombre}...")
        self.notificar_restauracion_servicio()

    def cargar_memoria(self):
        """Recupera la memoria exacta de dónde quedó el motor antes de cualquier corte de Render o Red"""
        if os.path.exists(self.archivo_memoria):
            try:
                with open(self.archivo_memoria, "r", encoding="utf-8") as f:
                    datos = json.load(f)
                    ciclos_previos = datos.get("ciclos_completados", 0)
                    logger.info(f"💾 [MEMORIA RECUPERADA] Retomando desde el ciclo #{ciclos_previos} sin perder el hilo")
                    return datos
            except Exception as e:
                logger.error(f"Error al leer la memoria de persistencia: {e}")

        # Estado inicial por defecto si arranca de cero
        return {
            "estado": "inicializado",
            "ciclos_completados": 0,
            "ultimo_latido": time.time(),
            "activos_vigilados": ["Volatility 500", "Volatility 1000", "GBP/USD"]
        }

    def guardar_memoria(self):
        """Guarda en tiempo real cada avance en disco"""
        try:
            with open(self.archivo_memoria, "w", encoding="utf-8") as f:
                json.dump(self.estado_sistema, f, indent=4, ensure_ascii=False)
        except Exception as e:
            logger.error(f"Error al guardar la memoria: {e}")

    def enviar_alerta_telegram(self, mensaje):
        """Envía avisos, notificaciones de reconexión y fallos a Telegram"""
        if self.telegram_token == "TU_TOKEN_DE_TELEGRAM_AQUI" or not self.telegram_token:
            logger.warning("Telegram no configurado -> " + mensaje)
            return

        url = f"https://api.telegram.org/bot{self.telegram_token}/sendMessage"
        payload = {"chat_id": self.chat_id, "text": mensaje, "parse_mode": "Markdown"}
        try:
            respuesta = requests.post(url, json=payload, timeout=3)
            if respuesta.status_code != 200:
                logger.error(f"Error al notificar a Telegram: {respuesta.text}")
        except Exception as e:
            logger.error(f"Falló la conexión con la API de Telegram: {e}")

    def notificar_restauracion_servicio(self):
        """Avisa inmediatamente a Telegram que el motor volvió a la vida y recuperó su lugar"""
        ciclos = self.estado_sistema.get("ciclos_completados", 0)
        mensaje = (
            "🛠️ *[SERVICIO RESTABLECIDO Y RECUPERADO]*\n"
            "• El motor se ha reconectado tras la interrupción.\n"
            f"• Memoria sincronizada: Retomando desde el ciclo #{ciclos}\n"
            "• Vigilancia activa e inmediata sobre: *Volatility 500, Volatility 1000 y GBP/USD*."
        )
        self.enviar_alerta_telegram(mensaje)

    def verificar_y_reconectar_deriv(self):
        """Verifica la conexión con Deriv y se reconecta al instante si hay fallos de red"""
        try:
            ws = websocket.create_connection(self.deriv_ws_url, timeout=2)
            ws.close()
            return True
        except Exception as e:
            logger.warning(f"Conexión con Deriv interrumpida. Reintentando reconexión inmediata... Detalle: {e}")
            # Bucle de reconexión rápida de alta frecuencia
            for intento in range(1, 4):
                try:
                    time.sleep(1)
                    ws = websocket.create_connection(self.deriv_ws_url, timeout=2)
                    ws.close()
                    logger.info("✅ Reconectado exitosamente a Deriv.")
                    return True
                except:
                    continue
            return False

    def latido_corazon(self):
        """Mantiene el pulso activo y actualiza la memoria segundo a segundo"""
        self.estado_sistema["ciclos_completados"] = self.estado_sistema.get("ciclos_completados", 0) + 1
        self.estado_sistema["ultimo_latido"] = time.time()
        self.guardar_memoria()

    def ejecutar_escaneo_manual(self):
        """Genera el reporte de estado exacto de los activos vigilados"""
        logger.info("Ejecutando escaneo manual del sistema...")
        ciclos = self.estado_sistema.get("ciclos_completados", 0)
        reporte = (
            "📊 *[INFORME DE ESTADO BLINDADO 24/7]*\n"
            "• Estado: Operando sin descanso\n"
            f"• Ciclos totales (con persistencia): {ciclos}\n"
            "• Activos bajo supervisión estricta:\n"
            "  - Volatility 500\n"
            "  - Volatility 1000\n"
            "  - GBP/USD\n"
            "• Auto-recuperación y reconexión: Activas"
        )
        self.enviar_alerta_telegram(reporte)

    def verificar_mensajes_telegram(self):
        """Escucha activa de comandos en tiempo real"""
        if self.telegram_token == "TU_TOKEN_DE_TELEGRAM_AQUI" or not self.telegram_token:
            return

        url = f"https://api.telegram.org/bot{self.telegram_token}/getUpdates?offset={self.ultimo_offset_telegram + 1}&timeout=1"
        try:
            respuesta = requests.get(url, timeout=2)
            if respuesta.status_code == 200:
                datos = respuesta.json()
                for resultado in datos.get("result", []):
                    self.ultimo_offset_telegram = resultado.get("update_id")
                    mensaje_obj = resultado.get("message", {})
                    texto_chat = mensaje_obj.get("text", "").strip().lower()
                    remitente_id = str(mensaje_obj.get("chat", {}).get("id", ""))

                    if remitente_id == str(self.chat_id):
                        if "escanear" in texto_chat or "escaneo" in texto_chat:
                            self.ejecutar_escaneo_manual()
                        elif "estado" in texto_chat:
                            ciclos = self.estado_sistema.get("ciclos_completados", 0)
                            self.enviar_alerta_telegram(
                                f"📈 *[ESTADO ACTUAL]*\n Ciclos: {ciclos}\n Monitoreo 24/7 de 500, 1000 y GBP/USD sin interrupción."
                            )
        except Exception as e:
            logger.error(f"Error al verificar mensajes de Telegram: {e}")

    def iniciar_motor_continuo(self):
        """Bucle principal ininterrumpido 24/7 con recuperación total de fallos"""
        logger.info("Motor en línea. Vigilando mercados 24/7.")
        self.enviar_alerta_telegram("🚀 *[MOTOR 24/7 EN LÍNEA]* Vigilancia absoluta sobre Volatility 500, Volatility 1000 y GBP/USD.")

        while True:
            try:
                # 1. Actualizar latido y guardar memoria de manera instantánea
                self.latido_corazon()

                # 2. Verificar y reconectar red de Deriv de inmediato si falla
                self.verificar_y_reconectar_deriv()

                # 3. Escuchar comandos de Telegram
                self.verificar_mensajes_telegram()

            except Exception as e:
                # Si ocurre cualquier incidencia con Render, la red o el servidor, avisa al instante
                error_bucle = f"⚠️ *[ALERTA DE INCIDENCIA EN EL MOTOR]*\nError detectado: {e}\nEl sistema se auto-recupera y continúa."
                logger.error(error_bucle)
                try:
                    self.enviar_alerta_telegram(error_bucle)
                except:
                    pass

            # Ciclo rápido continuo de alta frecuencia (sin pausas largas)
            time.sleep(1)

if __name__ == "__main__":
    try:
        mr = MotorInfraestructura()
        mr.iniciar_motor_continuo()
    except Exception as e:
        error_fatal = f"💥 *[PARADA CRÍTICA]* El motor colapsó por completo:\n{e}"
        logger.critical(error_fatal)
        try:
            mr.enviar_alerta_telegram(error_fatal)
        except:
            pass
